{
  "name": "bandy-quality-gate",
  "private": true,
  "version": "0.1.0",
  "description": "Automatiska regressionstester för Bandy Animator",
  "scripts": {
    "check:syntax": "node scripts/check-scripts.mjs",
    "test": "node scripts/prepare-visual-reference.mjs && playwright test",
    "test:smoke": "node scripts/prepare-visual-reference.mjs && playwright test --grep @smoke",
    "test:ui": "node scripts/prepare-visual-reference.mjs && playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0"
  }
}
